# Run npm run setup:demo to generate private local secrets in .env.local.
RESTROVA_DEMO_SESSION_SECRET=
# Use this same value in Apps Script's RESTROVA_SHEETS_SHARED_SECRET property.
RESTROVA_SHEETS_SHARED_SECRET=
# Deployed web app URL, not the spreadsheet URL or the Apps Script editor URL.
GOOGLE_SHEETS_URL=
